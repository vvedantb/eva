{
  "mcpServers": {
    "axiom": {
      "type": "http",
      "url": "https://mcp.axiom.co/mcp",
      "headers": {
        "Authorization": "Bearer ${AXIOM_MCP_PAT}",
        "x-axiom-org-id": "${AXIOM_ORG_ID}"
      }
    },
    "effect-docs": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "effect-mcp@latest"]
    }
  }
}
