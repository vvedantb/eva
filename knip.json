{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.{ts,mjs}"],
      "project": ["scripts/*.{ts,mjs}"]
    },
    "apps/web": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["src/lib/stageshow/**"]
    },
    "apps/mobile": {
      "entry": ["app/**/*.tsx!", "app.config.ts!"],
      "project": ["app/**/*.tsx", "src/**/*.{ts,tsx}", "app.config.ts"],
      "ignoreDependencies": [
        "@babel/core",
        "@expo/metro-runtime",
        "@expo/vector-icons",
        "@rn-primitives/select",
        "@rn-primitives/slot",
        "@rn-primitives/switch",
        "class-variance-authority",
        "clsx",
        "expo-auth-session",
        "expo-blur",
        "expo-crypto",
        "expo-font",
        "expo-haptics",
        "expo-linking",
        "expo-secure-store",
        "expo-system-ui",
        "expo-web-browser",
        "lucide-react-native",
        "react-dom",
        "react-native-reanimated",
        "react-native-safe-area-context",
        "react-native-screens",
        "react-native-svg",
        "react-native-worklets",
        "tailwind-merge",
        "tailwindcss"
      ]
    },
    "apps/chrome-extension": {
      "entry": ["src/background/index.ts", "src/content/index.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/backend": {
      "entry": [
        "convex/**/*.ts",
        "callback-src/**/*.ts",
        "scripts/**/*.{ts,mjs}",
        "tests/**/*.ts"
      ],
      "project": ["convex/**/*.ts", "callback-src/**/*.ts", "tests/**/*.ts"],
      "ignore": ["scripts/vercel-sandbox-spike/**"],
      "includeEntryExports": true
    },
    "packages/shared": {
      "project": ["src/**/*.ts"]
    },
    "packages/ui": {
      "project": ["src/**/*.{ts,tsx}"]
    }
  },
  "ignoreDependencies": ["@tiptap/pm", "lint-staged", "shadow-plugin"],
  "ignoreBinaries": ["setsid"],
  "ignoreIssues": {
    ".husky/**": ["binaries"],
    "packages/backend/convex/prosemirrorSync.ts": ["exports"],
    "apps/web/src/lib/components/mentions/mentionChipStyles.ts": ["duplicates"]
  },
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "binaries": "warn",
    "exports": "warn",
    "types": "warn",
    "duplicates": "warn"
  }
}
