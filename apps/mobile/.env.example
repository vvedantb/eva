# Copy to .env.local. Expo inlines EXPO_PUBLIC_* when it bundles.
# Use the same Clerk instance and Convex deployment as the web app.

# Web: VITE_CLERK_PUBLISHABLE_KEY
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Web: VITE_CONVEX_URL
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# Web origin, used for "Open on web" links.
EXPO_PUBLIC_WEB_URL=https://your-eva-web-origin.example

# Optional, push only: the Expo project id from `eas init`.
EAS_PROJECT_ID=
