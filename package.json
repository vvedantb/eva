{
  "private": true,
  "engines": {
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "pnpm --filter @eva/web dev",
    "convex": "pnpm --filter @eva/backend dev",
    "convex:deploy": "pnpm --filter @eva/backend run deploy",
    "convex:all": "pnpm --filter @eva/backend run dev:all",
    "ext:dev": "pnpm --filter eva-assist-extension dev",
    "ext:dev:once": "pnpm --filter eva-assist-extension dev:once",
    "ext:build": "pnpm --filter eva-assist-extension build",
    "ext:release": "npx tsx scripts/release-extension.ts",
    "lint": "oxlint -c .oxlintrc.json .",
    "typecheck": "pnpm --filter @eva/web typecheck && pnpm --filter @eva/backend typecheck && pnpm --filter @eva/backend typecheck:callback && pnpm --filter @eva/backend typecheck:annotation",
    "compiler:check": "node scripts/compiler-check.mjs",
    "test:oxlint-plugin": "node --test scripts/oxlint-plugin-eva/test/rules.test.mjs",
    "test:schema-narrowing": "node --test scripts/check-schema-narrowing.test.mjs",
    "check:schema-narrowing": "node scripts/check-schema-narrowing.mjs",
    "deadcode": "knip",
    "prepare": "husky",
    "doctor": "npx react-doctor@latest",
    "sync:prod-to-dev": "pnpm --filter @eva/backend run sync:prod-to-dev",
    "sync:prod-to-local": "pnpm --filter @eva/backend run sync:prod-to-local"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": "prettier --write",
    "*.{ts,tsx}": "oxlint -c .oxlintrc.json --no-error-on-unmatched-pattern"
  },
  "pnpm": {
    "overrides": {
      "@clerk/clerk-js": "5.125.10",
      "@clerk/clerk-react": "5.61.6",
      "@clerk/shared": "3.47.5",
      "@types/react": "19.0.10",
      "@types/react-dom": "19.0.4",
      "axios": "1.18.0",
      "brace-expansion@1.1.15": "1.1.18",
      "convex-helpers": "0.1.114",
      "fast-uri": "3.1.5",
      "form-data": "4.0.6",
      "hono": "4.12.25",
      "ip-address": "10.3.1",
      "js-cookie": "3.0.7",
      "js-yaml@3.14.2": "3.15.1",
      "linkify-it": "5.0.2",
      "react-router": "7.18.2",
      "react-router-dom": "7.18.2",
      "seroval": "1.5.3",
      "undici": "7.29.0",
      "ws@8.18.0": "8.21.0",
      "ws@8.18.3": "8.21.0",
      "ws@8.20.1": "8.21.0"
    },
    "patchedDependencies": {
      "@convex-dev/presence@0.3.0": "patches/@convex-dev__presence@0.3.0.patch"
    },
    "onlyBuiltDependencies": [
      "@swc/core"
    ],
    "packageExtensions": {
      "@convex-dev/prosemirror-sync": {
        "peerDependencies": {
          "@tiptap/pm": "*"
        }
      }
    }
  },
  "devDependencies": {
    "@oxlint/plugins": "1.79.0",
    "husky": "^9.1.7",
    "knip": "6.27.0",
    "lint-staged": "^16.2.7",
    "oxlint": "1.79.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48"
}
