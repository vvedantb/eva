{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "react", "unicorn", "oxc", "import"],
  "jsPlugins": [
    { "name": "vvedantb", "specifier": "@vvedantb/config/oxlint/plugin.mjs" },
    { "name": "anti-slop", "specifier": "@vvedantb/config/oxlint/anti-slop.js" },
    {
      "name": "no-effect",
      "specifier": "@vvedantb/config/oxlint/no-effect.mjs"
    }
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "vvedantb/no-comments": "error",
    "react/rules-of-hooks": "error",
    "react/capitalized-calls": "error",
    "react/exhaustive-deps": "warn",
    "react/react-in-jsx-scope": "off",
    "react/set-state-in-effect": "warn",
    "react/refs": "warn",
    "react/static-components": "warn",
    "react/purity": "warn",
    "import/no-duplicates": "error",
    "no-unused-vars": "warn",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "off",
    "anti-slop/no-known-value-widening": "off",
    "anti-slop/no-object-parameters": "off",
    "anti-slop/no-runtime-typeof": "off",
    "anti-slop/no-shape-in-symbol-names": "off",
    "anti-slop/no-unknown-parameters": "off",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "off",
    "anti-slop/no-widen-then-assert": "error",
    "no-effect/no-derived-state": "error",
    "no-effect/no-chain-state-updates": "error",
    "no-effect/no-event-handler": "error",
    "no-effect/no-adjust-state-on-prop-change": "error",
    "no-effect/no-reset-all-state-on-prop-change": "error",
    "no-effect/no-pass-live-state-to-parent": "error",
    "no-effect/no-pass-data-to-parent": "error",
    "no-effect/no-external-store-subscription": "error",
    "no-effect/no-initialize-state": "error",
    "vvedantb/no-is-record": "error",
    "vvedantb/no-json-parse": "warn",
    "vvedantb/no-double-cast": "warn",
    "vvedantb/no-value-block-in-try": "off",
    "vvedantb/no-source-text-in-tests": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-assertions": [
      "error",
      { "assertionStyle": "never" }
    ],
    "typescript/consistent-type-imports": [
      "error",
      { "fixStyle": "inline-type-imports" }
    ],
    "no-alert": "error",
    "no-unneeded-ternary": "error",
    "no-useless-concat": "error",
    "unicorn/no-abusive-eslint-disable": "error",
    "no-restricted-imports": [
      "warn",
      {
        "paths": [
          {
            "name": "react",
            "importNames": ["useEffect"],
            "message": "Avoid useEffect: derive state inline, use event handlers, or rely on Convex live queries. Unavoidable effects need a scoped oxlint-disable with a reason. See CLAUDE.md."
          }
        ]
      }
    ],
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "complexity": ["warn", { "max": 20 }]
  },
  "overrides": [
    {
      "files": ["apps/web/src/**"],
      "rules": {
        "vvedantb/no-value-block-in-try": "error",
        "no-restricted-globals": [
          "error",
          {
            "name": "localStorage",
            "message": "Use useLocalStorage from usehooks-ts. Raw access is only for code that runs outside React (see the allowlist in .oxlintrc.json)."
          },
          {
            "name": "sessionStorage",
            "message": "Use useSessionStorage from usehooks-ts. Raw access is only for code that runs outside React (see the allowlist in .oxlintrc.json)."
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "window",
            "property": "localStorage",
            "message": "Use useLocalStorage from usehooks-ts. Raw access is only for code that runs outside React (see the allowlist in .oxlintrc.json)."
          },
          {
            "object": "window",
            "property": "sessionStorage",
            "message": "Use useSessionStorage from usehooks-ts. Raw access is only for code that runs outside React (see the allowlist in .oxlintrc.json)."
          }
        ]
      }
    },
    {
      "files": [
        "apps/web/src/**/*.test.ts",
        "apps/web/src/**/*.test.tsx",
        "apps/web/src/lib/authHint.ts",
        "apps/web/src/lib/contexts/themeHint.ts",
        "apps/web/src/lib/components/ThemeModeProvider.tsx",
        "apps/web/src/lib/utils/staleDeployReload.ts",
        "apps/web/src/lib/migrateLegacyStorageKeys.ts",
        "apps/web/src/lib/components/sandbox/useSandboxPreview.ts",
        "apps/web/src/routes/_repo/$owner/$repo/sessions/_utils/previewViewport.ts",
        "apps/web/src/lib/components/notifications/desktopNotifications.ts"
      ],
      "rules": {
        "no-restricted-globals": "off",
        "no-restricted-properties": "off"
      }
    },
    {
      "files": ["packages/shared/src/index.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react-dom",
                  "@eva/ui",
                  "@eva/ui/*",
                  "@vvedantb/ui",
                  "facehash",
                  "convex-helpers/react",
                  "convex-helpers/react/*",
                  "./components/user-initials"
                ],
                "message": "The @eva/shared root barrel is bundled into Convex functions, so it must stay free of frontend code. Add a subpath export in packages/shared/package.json instead."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/backend/**"],
      "rules": {
        "no-console": "off",
        "no-restricted-imports": "off",
        "no-alert": "off"
      }
    },
    {
      "files": ["apps/mobile/src/**", "apps/mobile/app/**", "packages/shared/src/**"],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "property": "toSorted",
            "message": "Hermes (the phone engine) lacks the ES2023 array copy methods; this crashed the phone Sessions tab. Copy, then sort: [...list].sort()."
          },
          {
            "property": "toReversed",
            "message": "Hermes (the phone engine) lacks the ES2023 array copy methods. Copy, then reverse: [...list].reverse()."
          },
          {
            "property": "toSpliced",
            "message": "Hermes (the phone engine) lacks the ES2023 array copy methods. Copy, then splice."
          },
          {
            "object": "Object",
            "property": "groupBy",
            "message": "Hermes (the phone engine) lacks Object.groupBy. Build the groups with a loop or a Map."
          },
          {
            "object": "Map",
            "property": "groupBy",
            "message": "Hermes (the phone engine) lacks Map.groupBy. Build the Map with a loop."
          },
          {
            "object": "Promise",
            "property": "withResolvers",
            "message": "Hermes (the phone engine) lacks Promise.withResolvers. Use new Promise((resolve, reject) => ...)."
          },
          {
            "object": "Array",
            "property": "fromAsync",
            "message": "Hermes (the phone engine) lacks Array.fromAsync. Collect with for await."
          }
        ],
        "no-restricted-globals": [
          "error",
          {
            "name": "structuredClone",
            "message": "Hermes (the phone engine) has no structuredClone. Copy the shape you need explicitly."
          }
        ]
      }
    },
    {
      "files": [
        "apps/chrome-extension/tailwind.config.js",
        "apps/mobile/babel.config.js",
        "apps/mobile/plugins/withReleaseSigning.js",
        "apps/mobile/src/ui/fonts.js",
        "apps/mobile/tailwind.config.js",
        "apps/web/src/lib/components/PreviewNavBar.tsx",
        "apps/web/src/lib/components/chat/chatBodyUtils.ts",
        "apps/web/src/lib/components/sandbox/useSandboxPanes.ts",
        "apps/web/src/lib/components/tasks/SchedulePopover.tsx",
        "apps/web/src/routes/_global/home/_components/RepoCard.tsx",
        "apps/web/src/routes/_global/home/_components/RepoGroup.tsx",
        "apps/web/src/routes/_repo/$owner/$repo/automations/AutomationClient.tsx",
        "apps/web/src/routes/_repo/$owner/$repo/automations/_components/FindingRow.tsx",
        "apps/web/src/routes/_repo/$owner/$repo/automations/_components/RunEmailPanel.tsx",
        "apps/web/src/routes/_repo/$owner/$repo/automations/_components/SystemAutomationCard.tsx",
        "apps/web/src/routes/_repo/$owner/$repo/automations/_components/SystemAutomationSettings.tsx",
        "apps/web/src/routes/_repo/$owner/$repo/projects/ProjectsClient.tsx",
        "apps/web/src/routes/_repo/$owner/$repo/projects/_components/ProjectDetailHeaderActions.tsx",
        "apps/web/src/routes/_repo/$owner/$repo/projects/_components/ProjectDetailSandboxContent.tsx",
        "apps/web/src/routes/_repo/$owner/$repo/projects/_components/ProjectsSelectButton.tsx",
        "apps/web/src/routes/_repo/$owner/$repo/quick-tasks/_components/QuickTaskDetailHeaderActions.tsx",
        "apps/web/src/routes/_repo/$owner/$repo/quick-tasks/_components/QuickTaskDetailShell.tsx",
        "apps/web/src/routes/_repo/$owner/$repo/quick-tasks/_components/QuickTasksListSplit.tsx",
        "apps/web/src/routes/_repo/$owner/$repo/quick-tasks/_components/QuickTasksToolbar.tsx",
        "apps/web/src/routes/_repo/$owner/$repo/sessions/DesktopPanel.tsx",
        "apps/web/src/routes/_repo/$owner/$repo/sessions/_components/AnnotationCommentCard.tsx",
        "apps/web/src/routes/_repo/$owner/$repo/sessions/_components/CachedSessionShell.tsx",
        "apps/web/src/routes/_repo/$owner/$repo/sessions/_components/FileViewerEditControls.tsx",
        "apps/web/src/routes/_repo/$owner/$repo/sessions/_components/FileViewerHeader.tsx",
        "apps/web/src/routes/_repo/$owner/$repo/sessions/_components/NewSessionComposer.tsx",
        "apps/web/src/routes/_repo/$owner/$repo/sessions/_components/PreviewAnnotationLayer.tsx",
        "apps/web/src/routes/_repo/$owner/$repo/sessions/_components/SandboxFileTree.tsx",
        "apps/web/src/routes/_repo/$owner/$repo/sessions/_components/SandboxTabBarTools.tsx",
        "apps/web/src/routes/_repo/$owner/$repo/sessions/_components/SessionHeaderMenu.tsx",
        "apps/web/src/routes/_repo/$owner/$repo/sessions/route.tsx",
        "apps/web/src/routes/_repo/$owner/$repo/settings/TeamEnvVarsClient.tsx",
        "apps/web/src/routes/_repo/$owner/$repo/settings/_components/BuildRow.tsx",
        "apps/web/src/routes/_repo/$owner/$repo/settings/_components/CustomTabRow.tsx",
        "apps/web/src/routes/_repo/$owner/$repo/settings/skills/_components/SkillRow.tsx",
        "apps/web/src/routes/_repo/$owner/$repo/settings/skills/_components/SystemSkillRow.tsx",
        "apps/web/tailwind.config.js",
        "packages/backend/convex/_sandbox_runtime/gitCredentials.ts",
        "packages/backend/convex/_validators/enums.ts",
        "packages/backend/convex/_validators/tableFields.ts",
        "packages/backend/convex/schema.ts",
        "packages/backend/convex/snapshotActions.ts",
        "packages/backend/convex/taskWorkflowActions.ts",
        "packages/backend/scripts/sync-to-local.mjs",
        "packages/backend/scripts/vercel-sandbox-spike/managed-image-spike.mjs",
        "packages/shared/src/modelPricing.ts",
        "scripts/check-schema-narrowing.mjs",
        "scripts/check-shared-backend.mjs",
        "scripts/design-check.mjs"
      ],
      "rules": { "vvedantb/no-comments": "off" }
    }
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/_generated/**",
    "**/*.generated.ts",
    "**/routeTree.gen.ts",
    "**/*.d.ts",
    "**/.output/**",
    "**/.vite/**",
    "**/.wxt/**",
    "video/**",
    ".claude/skills/**",
    ".agents/skills/**",
    "apps/web/src/lib/stageshow/**"
  ]
}
