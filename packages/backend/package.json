{
  "name": "@eva/backend",
  "version": "1.0.0",
  "private": true,
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "dev": "convex dev",
    "dev:personal": "cross-env CONVEX_DEPLOYMENT=dev:elegant-snail-639 convex dev",
    "dev:evalucom": "cross-env CONVEX_DEPLOYMENT=dev:good-mule-506 convex dev",
    "dev:all": "concurrently -n personal,evalucom -c blue,green \"pnpm dev:personal\" \"pnpm dev:evalucom\"",
    "typecheck": "tsc --noEmit -p convex/tsconfig.json",
    "typecheck:callback": "tsc --noEmit -p callback-src/tsconfig.json",
    "typecheck:annotation": "tsc --noEmit -p preview-annotation-src/tsconfig.json",
    "build:callback": "node scripts/build-callback-script.mjs",
    "build:annotation": "node scripts/build-annotation-script.mjs",
    "sync:prod-to-dev": "node scripts/sync-prod-to-dev.mjs",
    "sync:prod-to-local": "node scripts/sync-to-local.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "predeploy": "pnpm run build:callback && pnpm run build:annotation",
    "deploy": "convex deploy"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.28",
    "@anthropic-ai/claude-agent-sdk": "0.3.258",
    "@clerk/backend": "^2.33.3",
    "@convex-dev/action-cache": "^0.3.1",
    "@convex-dev/crons": "^0.2.0",
    "@convex-dev/migrations": "0.3.5",
    "@convex-dev/presence": "^0.3.0",
    "@convex-dev/prosemirror-sync": "^0.2.1",
    "@convex-dev/workflow": "^0.3.4",
    "@cursor/sdk": "1.0.28",
    "@eva/shared": "workspace:*",
    "@jitl/quickjs-singlefile-cjs-release-sync": "^0.32.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@octokit/auth-app": "^8.1.2",
    "@openai/codex-sdk": "^0.146.0",
    "@sendgrid/mail": "^8.1.6",
    "@solvers-hub/llm-json": "^0.1.8",
    "@tiptap/core": "^3.20.1",
    "@tiptap/markdown": "^3.20.1",
    "@tiptap/pm": "^3.20.1",
    "@tiptap/starter-kit": "^3.20.1",
    "@vercel/sandbox": "^3.0.0",
    "ai": "^6.0.164",
    "convex": "^1.40.0",
    "convex-helpers": "0.1.114",
    "jose": "^6.0.11",
    "marked": "^18.0.0",
    "octokit": "^5.0.5",
    "pg": "^8.21.0",
    "quickjs-emscripten-core": "^0.32.0",
    "shell-quote": "^1.9.0",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.18.5",
    "@types/pg": "^8.20.0",
    "concurrently": "^9.1.2",
    "convex-test": "^0.0.41",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.0",
    "html2canvas": "^1.4.1",
    "typescript": "7.0.1-rc",
    "vitest": "^3.2.4"
  }
}
